# FinTrack Environment Configuration
FLASK_SECRET_KEY=change-me-to-a-long-random-secret-key
FLASK_ENV=development
PORT=5000
DATABASE_PATH=fintrack.db

# Optional: Upstox API v3 Access Token for real-time NSE market quotes & WebSocket feed
# Leave blank to automatically use yfinance + simulated fallback engine
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_BASE=https://api.upstox.com/v3

# Background tick broadcast interval in seconds
MARKET_STREAM_INTERVAL=2
